<div class="cpb-subnet-builder">

  {{!-- Toolbar --}}
  <div class="cpb-sb-toolbar">
    <span class="cpb-sb-title">
      <i class="fa-solid fa-diagram-project"></i>
      {{localize "CYBER_BLUE.SubnetBuilder.Title"}}
    </span>

    <button type="button" data-action="undo" title="{{localize "CYBER_BLUE.SubnetBuilder.Undo"}}">
      <i class="fa-solid fa-rotate-left"></i>
    </button>
    <button type="button" data-action="redo" title="{{localize "CYBER_BLUE.SubnetBuilder.Redo"}}">
      <i class="fa-solid fa-rotate-right"></i>
    </button>
    <button type="button" data-action="fit" title="{{localize "CYBER_BLUE.SubnetBuilder.Fit"}}">
      <i class="fa-solid fa-expand"></i>
    </button>

    <span class="cpb-sb-spacer"></span>

    <button type="button" data-action="import" title="{{localize "CYBER_BLUE.SubnetBuilder.ImportHint"}}">
      <i class="fa-solid fa-file-import"></i>
      {{localize "CYBER_BLUE.SubnetBuilder.Import"}}
    </button>
    <button type="button" data-action="export" title="{{localize "CYBER_BLUE.SubnetBuilder.ExportHint"}}">
      <i class="fa-solid fa-file-export"></i>
      {{localize "CYBER_BLUE.SubnetBuilder.Export"}}
    </button>
    <button type="button" class="cpb-sb-save" data-action="save" title="{{localize "CYBER_BLUE.SubnetBuilder.SaveHint"}}">
      <i class="fa-solid fa-floppy-disk"></i>
      {{localize "CYBER_BLUE.SubnetBuilder.Save"}}
    </button>
  </div>

  <div class="cpb-sb-main">

    {{!-- Node graph canvas --}}
    <div class="cpb-sb-canvas-wrap">
      <canvas data-sb-canvas tabindex="0"></canvas>
      <span class="cpb-sb-status" data-sb-status></span>
    </div>

    {{!-- Node options panel (populated by JS) --}}
    <aside class="cpb-sb-rail" data-sb-rail></aside>

  </div>
</div>
